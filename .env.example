# Configurações de Produção — VPS (Docker Compose)
# Copie este arquivo para .env no servidor: cp .env.example .env

# Connection string do pooler do Supabase (porta 6543 - Transaction Mode)
# Para Postgres local: postgresql://postgres:postgres@localhost:5432/encurtador
DATABASE_URL=postgresql://postgres.<SEU-PROJECT-REF>:<SUA-SENHA>@aws-0-sa-east-1.pooler.supabase.co:6543/postgres

# Opcional: força TLS na conexão com o banco (true/false).
# Sem definir, usa SSL automaticamente para Supabase (host *.supabase.co ou porta 6543).
# DATABASE_SSL=true

# Porta interna da API (usada pelo Nginx via app:5000)
PORT=5000

# Origens permitidas para CORS (* ou lista separada por vírgula)
# Exemplo: https://meuencurtador.com.br,https://encurtador.vercel.app
FRONTEND_ORIGIN=*

# Opcional: força o domínio público nos links gerados.
# Sem isso, o backend usa o Host da requisição (X-Forwarded-Host via Nginx).
# PUBLIC_BASE_URL=https://meuencurtador.com.br

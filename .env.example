# Configurações de Produção — Hostinger VPS (Debian + Docker Compose)
# Copie este arquivo para .env no servidor: cp .env.example .env

# Connection string do pooler do Supabase (porta 6543 - Transaction Mode)
DATABASE_URL=postgresql://postgres.<SEU-PROJECT-REF>:<SUA-SENHA>@aws-0-sa-east-1.pooler.supabase.co:6543/postgres

# Chave secreta longa para a permutação de Feistel
# Dica para gerar no terminal: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCURTADOR_KEY=defina_uma_chave_secreta_longa_aqui

# Origens permitidas para CORS (* para todas as origens ou o domínio da sua Hostinger VPS)
# Exemplo: https://meuencurtador.com.br,http://185.xxx.xxx.xxx
FRONTEND_ORIGIN=*
